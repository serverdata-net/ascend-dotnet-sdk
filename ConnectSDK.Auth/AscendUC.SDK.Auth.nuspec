<?xml version="1.0" encoding="utf-8" ?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
	<metadata>
		<id>AscendUC.SDK</id>
		<version>$version$</version>
		<authors>Ascend</authors>
		<owners>ServerData</owners>
		<license type="expression">MIT</license>
		<projectUrl>https://developer.ascendcloud.com/index.html</projectUrl>
		<repository type="git" url="https://github.com/serverdata-net/ascend-dotnet-sdk"/>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<description>
			Perform the Ascend API OAuth 2.0 - authentication and
			authorization to access Ascend API
		</description>
		<copyright>serverdata.net, Inc.</copyright>
		<tags>SDK Ascend</tags>
		<icon>icon.png</icon>
		<dependencies>
			<group targetFramework="net8.0">
				<dependency id="System.Text.Json" version="9.0.4" exclude="Build,Analyzers" />
				<dependency id="System.IdentityModel.Tokens.Jwt" version="6.34.0" exclude="Build,Analyzers" />
				<dependency id="Duende.IdentityModel" version="7.0.0" exclude="Build,Analyzers" />
				<dependency id="AscendUC.SDK.Common" version="[2.0,3.0)" exclude="Build,Analyzers" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="bin\Debug\net8.0\ConnectSDK.Auth.dll" target="lib\net8.0\ConnectSDK.Auth.dll" />
		<file src="..\icon.png" target=""/>
	</files>
</package>